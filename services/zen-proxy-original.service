[Unit]
Description=Zen pacing proxy (bypass burst rate limit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/mint/.nvm/versions/node/v24.21.0/bin/node /home/mint/.local/share/opencode/zen-proxy.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
