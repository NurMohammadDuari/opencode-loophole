[Unit]
Description=OpenCode Loophole Control Dashboard Server
After=zen-bridge.service g4f-api.service
Wants=zen-bridge.service g4f-api.service

[Service]
Type=simple
ExecStart=/home/mint/.nvm/versions/node/v24.21.0/bin/node /home/mint/.local/share/opencode/dashboard/dashboard-server.js
Restart=always
RestartSec=3
Environment=DASHBOARD_PORT=1395
Environment=HOME=/home/mint

[Install]
WantedBy=default.target
