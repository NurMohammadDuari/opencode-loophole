[Unit]
Description=Zen rotator (rotate x-real-ip to reset zen per-IP daily buckets)

[Service]
Type=simple
ExecStart=/home/mint/.nvm/versions/node/v24.21.0/bin/node /home/mint/.local/share/opencode/zen-rotator.js
Restart=always
RestartSec=3
Environment=ZEN_ROTATOR_PORT=1341

[Install]
WantedBy=default.target