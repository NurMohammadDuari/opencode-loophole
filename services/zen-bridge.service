[Unit]
Description=Zen OpenAI bridge (chat/completions -> local opencode serve session API)
After=opencode-serve.service
Wants=opencode-serve.service

[Service]
Type=simple
ExecStart=/home/mint/.nvm/versions/node/v24.21.0/bin/node /home/mint/.local/share/opencode/zen-bridge.js
Restart=always
RestartSec=3
Environment=BRIDGE_PORT=1343
Environment=SERVE_PORT=18765
Environment=SERVE_USER=opencode
Environment=SERVE_PASS=opencodepass

[Install]
WantedBy=default.target