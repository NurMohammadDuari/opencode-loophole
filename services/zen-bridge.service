[Unit]
Description=Zen OpenAI bridge (chat/completions + responses -> local opencode serve session API)
After=opencode-serve.service
Wants=opencode-serve.service

[Service]
Type=simple
ExecStart=/home/mint/.nvm/versions/node/v24.21.0/bin/node /home/mint/.local/share/opencode/zen-bridge.js
Restart=always
RestartSec=3
Environment=BRIDGE_PORT=1343
Environment=SERVE_PORT=18765
Environment=SERVE_USER=opencode
Environment=SERVE_PASS=opencodepass
Environment=HOME=/home/mint/.local/share/opencode/servehome
Environment=FAST_RACE=0
# 900s: heavy agent turns (reasoning + tools) legitimately run many minutes;
# a 180s cap here killed long turns at exactly 3 min (blank/partial output)
Environment=ZEN_TIMEOUT_MS=900000
# 300s: silent tool runs (bash builds, scans) produce no events for minutes;
# a 90s stall window cut agent turns that were still working
Environment=STREAM_STALL_MS=300000
Environment=EMPTY_STREAM_GRACE_MS=90000
Environment=RECOVERY_TIMEOUT_MS=45000
Environment=RECOVERY_MAX_ATTEMPTS=3
Environment=SESSION_TTL_MS=90000
# Native tool cards on the Responses path (rendered as mcp.<tool>). 0 = plain text.
Environment=ZEN_TOOL_CARDS=1

[Install]
WantedBy=default.target
